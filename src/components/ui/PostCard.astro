---
import type { PostCard } from '../../types/sanity';
import { thumbnailUrl } from '../../lib/imageUrl';

interface Props {
  post: PostCard;
}

const { post } = Astro.props;

const href = `/${post.category.slug.current}/${post.slug.current}/`;
const formattedDate = new Date(post.publishedAt).toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group flex flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white transition-shadow hover:shadow-lg">
  <!-- Imagem de capa -->
  <a href={href} tabindex="-1" aria-hidden="true" class="block overflow-hidden">
    {
      post.coverImage ? (
        <img
          src={thumbnailUrl(post.coverImage)}
          alt={post.coverImage.alt ?? post.title}
          width={400}
          height={250}
          loading="lazy"
          decoding="async"
          class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-48 w-full items-center justify-center bg-neutral-100">
          <span class="text-4xl text-neutral-300" aria-hidden="true">📄</span>
        </div>
      )
    }
  </a>

  <!-- Conteúdo -->
  <div class="flex flex-1 flex-col p-5">
    <!-- Categoria badge -->
    <a
      href={`/${post.category.slug.current}/`}
      class="mb-3 inline-flex w-fit items-center rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700 transition-colors hover:bg-brand-100"
    >
      {post.category.name}
    </a>

    <!-- Título -->
    <h3 class="mb-2 text-base font-semibold leading-snug text-neutral-900">
      <a
        href={href}
        class="transition-colors hover:text-brand-600"
      >
        {post.title}
      </a>
    </h3>

    <!-- Excerpt -->
    {post.excerpt && (
      <p class="mb-4 flex-1 text-sm leading-relaxed text-neutral-500 line-clamp-2">
        {post.excerpt}
      </p>
    )}

    <!-- Data -->
    <time
      datetime={post.publishedAt}
      class="mt-auto text-xs text-neutral-400"
    >
      {formattedDate}
    </time>
  </div>
</article>
