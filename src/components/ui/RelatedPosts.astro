---
import type { PostCard } from '../../types/sanity';
import PostCardComponent from './PostCard.astro';

interface Props {
  posts: PostCard[];
  title?: string;
}

const { posts, title = 'Posts Relacionados' } = Astro.props;
---

{
  posts.length > 0 && (
    <section aria-labelledby="related-posts-heading" class="mt-16 border-t border-neutral-200 pt-12">
      <h2 id="related-posts-heading" class="mb-8 text-2xl font-bold text-neutral-900">
        {title}
      </h2>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <PostCardComponent post={post} />
        ))}
      </div>
    </section>
  )
}
