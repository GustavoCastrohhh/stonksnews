---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/ui/PostCard.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import { getAllCategories, getPostsByCategory } from "../../lib/queries";
import type { GetStaticPaths } from "astro";
import type { Category } from "../../types/sanity";

export const getStaticPaths: GetStaticPaths = async () => {
  const categories = await getAllCategories();

  return categories.map((cat) => ({
    params: { category: cat.slug.current },
    props: { category: cat as Category },
  }));
};

interface Props {
  category: Category;
}
const { category } = Astro.props;
const posts = await getPostsByCategory(category.slug.current);

const pageTitle = category.seoTitle ?? `${category.name} | Artigos e Conteúdo`;
const pageDescription =
  category.description ?? `Explore todos os artigos sobre ${category.name}.`;

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: category.name, href: `/${category.slug.current}/` },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <Breadcrumb items={breadcrumbs} />

    <!-- Cabeçalho do silo -->
    <header class="mb-12">
      <h1
        class="text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl"
      >
        {category.name}
      </h1>
      {
        category.description && (
          <p class="mt-4 max-w-2xl text-lg text-neutral-500">
            {category.description}
          </p>
        )
      }
      <p class="mt-2 text-sm text-neutral-400">
        {posts.length}
        {posts.length === 1 ? "artigo" : "artigos"}
      </p>
    </header>

    <!-- Grid de posts -->
    {
      posts.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-neutral-300 py-24 text-center">
          <p class="text-neutral-400">
            Nenhum artigo publicado nesta categoria ainda.
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>
